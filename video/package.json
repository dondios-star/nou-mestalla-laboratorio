{
  "name": "nou-mestalla-video",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "studio": "remotion studio src/index.tsx --no-open --port=3000",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts",
    "render:smoke": "node scripts/render-smoke.mjs",
    "verify": "python3 scripts/verify-smoke.py",
    "validate": "npm run typecheck && npm test && npm run render:smoke && npm run verify",
    "check:studio": "node scripts/inspect-studio.mjs",
    "render:ep45": "node scripts/ep45-render.mjs final",
    "ep45:assets": "node scripts/ep45-render.mjs background && node scripts/ep45-render.mjs proofs && node scripts/ep45-render.mjs assets",
    "ep45:checks": "node scripts/ep45-render.mjs checks",
    "verify:ep45": "python3 scripts/verify-ep45.py"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.540",
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@remotion/three": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.183.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
